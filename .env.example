# Copy to .env.local and fill in. .env.local is gitignored.

# --- Existing Supabase project (already carries migrations 0001–0006) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used only by `npm run db:inspect` and
# `npm run db:migrate`. Supabase dashboard → Project Settings → Database →
# Connection string → URI. The app itself never uses this.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- OpenRouter (every model call goes through here, free Nemotron tier) ---
OPENROUTER_API_KEY=
MODEL_ROUTINE=nex-agi/nex-n2.5-mini:free
MODEL_JUDGMENT=dots-studio/dots-3-note-preview:free

# --- Remote.com sandbox only. Never a production token. ---
REMOTE_API_TOKEN=ra_test_...
REMOTE_API_BASE=https://gateway.remote-sandbox.com
